{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": { "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }] },
  "overrides": [
    {
      // 在 override 中只增加 Hooks 规则，保留原插件，避免开启全部 React 默认规则。
      "files": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "plugins": ["unicorn", "typescript", "oxc", "react"],
      "rules": { "react/rules-of-hooks": "error", "react/exhaustive-deps": "warn" }
    },
    {
      // 首次扫描的存量调用位置诊断仍告警；逐文件修复后删除例外，不扩大到目录。
      // 依赖诊断与其他规则不降级，详见 docs/testing/react-hooks-lint.md。
      "files": ["**/packages/desktop/test/e2e/helpers/web-remote-visibility-browser.ts"],
      "plugins": ["unicorn", "typescript", "oxc", "react"],
      "rules": { "react/rules-of-hooks": "warn" }
    },
    {
      // 会话控制核心只依赖契约和注入端口，禁止把运行环境重新耦合进用例。
      "files": ["packages/session-control/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "node:*/**",
                  "fs",
                  "fs/**",
                  "child_process",
                  "worker_threads",
                  "net",
                  "http",
                  "https",
                  "http2",
                  "dgram",
                  "dns",
                  "dns/**",
                  "tls",
                  "os",
                  "path",
                  "path/**",
                  "crypto",
                  "stream",
                  "stream/**",
                  "timers",
                  "timers/**",
                  "process",
                  "module",
                  "vm",
                  "electron",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "zustand",
                  "zustand/**",
                  "@zcode/services",
                  "@zcode/services/**",
                  "@zcode/shared",
                  "@zcode/shared/**",
                  "@zcode/core",
                  "@zcode/core/**",
                  "@zcode/bootstrap",
                  "@zcode/bootstrap/**",
                  "@zcode/adapters",
                  "@zcode/adapters/**",
                  "**/services/src/**",
                  "**/apps/zcode-cli/**"
                ],
                "message": "Session control uses injected ports; environment and host implementations belong in adapters."
              },
              {
                "group": [
                  "../cli/**",
                  "../app/**",
                  "../../cli/**",
                  "../../app/**",
                  "@zcode/session-control/cli",
                  "@zcode/session-control/app",
                  "#src/application/cli/**",
                  "#src/application/app/**",
                  "#session-control/application/cli/**",
                  "#session-control/application/app/**"
                ],
                "message": "CLI and App use cases are independent; share contracts or pure domain rules instead."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "process",
          "window",
          "fetch",
          "setTimeout",
          "setInterval",
          "Date"
        ]
      }
    },
    // 沿用官方既有大文件的行数告警，只恢复固定路径；不把行数当作机械拆分的理由。
    {
      "files": [
        "**/apps/zcode-cli/packages/adapters/src/plugins/marketplace.ts",
        "**/apps/zcode-cli/packages/adapters/src/mcp/index.ts",
        "**/apps/zcode-cli/packages/adapters/src/model/runner-stream.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/plugins.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/migrations.ts",
        "**/apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/create-app.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/app/session-facade.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/v4-gateway.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/product-projection.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol-v4/transcript-hydration.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/server.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/session-mapper.ts",
        "**/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/v4-bridge.ts",
        "**/apps/zcode-cli/packages/contracts/src/interfaces/session-store.port.ts",
        "**/apps/zcode-cli/packages/contracts/src/model/index.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/session-fork.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/steering.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn.ts",
        "**/apps/zcode-cli/packages/core/src/runtime/methods/turn-model-step.ts",
        "src/runtime/methods/session-fork.ts",
        "src/runtime/methods/steering.ts",
        "src/runtime/methods/turn.ts",
        "src/runtime/methods/turn-model-step.ts",
        "**/packages/ui/src/remote-connection-flow/index.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 800,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      // 这两处专门过滤文件名/协议字段里的控制字符，匹配控制字符是安全边界本身。
      // managed 模块不增加内联 lint disable，例外仅限此规则与这两个文件。
      "files": [
        "packages/ui/src/plugin-ui/domain/pluginUiDownloadFile.ts",
        "packages/shared/src/zcode-protocol-v4/transport.ts"
      ],
      "rules": { "no-control-regex": "off" }
    },
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      // 后缀必须覆盖 .mjs/.js：scripts/ 与 packages/*/test/ 下的测试是 .mjs，
      // 漏掉它们会让超出生产上限的测试文件误报（见 formatting-gate.md）。
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.mjs",
        "**/*.spec.mjs",
        "**/*.test.js",
        "**/*.spec.js"
      ],
      "rules": { "max-lines": "off" }
    },
    { "files": ["**/i18n/locales/*.ts"], "rules": { "max-lines": "off" } },
    {
      // 这些无 test/spec 后缀的文件仅为验收夹具和 E2E helper，与已有测试使用同一行数规则。
      // 精确列举，避免把相邻生产入口或未来 scripts 文件误当测试。
      "files": [
        "packages/web/test/e2e/remote-control/transport/manual-review/pending/remote-submit-lifecycle.mjs",
        "packages/web/test/e2e/remote-control/authentication/manual-review/pending/remote-login-v2.mjs",
        "packages/web/test/e2e/remote-control/transport/manual-review/pending/remote-large-rpc.mjs",
        "packages/desktop/test/e2e/helpers/project-sidebar.ts",
        "packages/desktop/scripts/mcp-apps-host-fixture/managed-renderer.tsx",
        "packages/desktop/scripts/mcp-apps-host-fixture/background-main.ts",
        "packages/desktop/scripts/gen-ui-fixture/main.ts",
        "packages/desktop/scripts/auto-update-network-smoke.mjs",
        "packages/desktop/scripts/auto-update-ca-constraints-smoke.mjs",
        "packages/desktop/test/e2e/helpers/model-provider-restart.ts",
        "packages/ui/test/browser/manual-review/pending/tool-summary-spacing.fixture.tsx",
        "packages/ui/test/browser/manual-review/pending/conversation-timeline-resize.fixture.tsx",
        "packages/ui/test/browser/manual-review/pending/new-task-rendering.fixture.tsx"
      ],
      "rules": { "max-lines": "off" }
    }
  ],
  "settings": {
    "jsx-a11y": { "polymorphicPropName": null, "components": {}, "attributes": {} },
    "next": { "rootDir": [] },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": { "typecheck": false }
  },
  "env": { "builtin": true },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "docs/electron"
  ]
}
