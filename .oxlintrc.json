{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 这两处专门过滤文件名/协议字段里的控制字符，匹配控制字符是安全边界本身。
      // managed 模块不增加内联 lint disable，例外仅限此规则与这两个文件。
      "files": [
        "packages/ui/src/plugin-ui/domain/pluginUiDownloadFile.ts",
        "packages/shared/src/zcode-protocol-v4/transport.ts"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      // 后缀必须覆盖 .mjs/.js：scripts/ 与 packages/*/test/ 下的测试是 .mjs，
      // 漏掉它们会让「格式化后超 400 行」在测试文件上误报（见 formatting-gate.md）。
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.mjs",
        "**/*.spec.mjs",
        "**/*.test.js",
        "**/*.spec.js"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // 这些无 test/spec 后缀的文件仅为验收夹具和 E2E helper，与已有测试使用同一行数规则。
      // 精确列举，避免把相邻生产入口或未来 scripts 文件误当测试。
      "files": [
        "packages/web/test/e2e/manual-review/pending/remote-submit-lifecycle.mjs",
        "packages/web/test/e2e/manual-review/pending/remote-login-v2.mjs",
        "packages/web/test/e2e/manual-review/pending/remote-large-rpc.mjs",
        "packages/desktop/test/e2e/helpers/project-sidebar.ts",
        "packages/desktop/scripts/mcp-apps-host-fixture/managed-renderer.tsx",
        "packages/desktop/scripts/mcp-apps-host-fixture/background-main.ts",
        "packages/desktop/scripts/gen-ui-fixture/main.ts"
      ],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "docs/electron"
  ]
}
