{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**", "!.turbo/**"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "build:desktop-agent": {
      "dependsOn": [
        "@zcode/shared-types#build",
        "@zcode/contracts#build",
        "@zcode/dynamic-workflow#build",
        "@zcode/core#build",
        "@zcode/adapters#build",
        "@zcode/bootstrap#build",
        "@zcode/i18n#build",
        "@zcode/node-repl-host#build",
        "@zcode/browser-use-plugin#build",
        "@zcode/documents-plugin#build",
        "@zcode/spreadsheets-plugin#build",
        "@zcode/presentations-plugin#build",
        "@zcode/pdf-plugin#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/../../packages/shared/package.json",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/zcode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/zcode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["ZCODE_ENV", "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@zcode/cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "$TURBO_ROOT$/../../config/provider/zcode-builtin.json",
        "$TURBO_ROOT$/../../scripts/builtin-provider-config.mjs",
        "$TURBO_ROOT$/../../scripts/load-endpoint-env.mjs",
        "$TURBO_ROOT$/../../packages/provider/src/**",
        "$TURBO_ROOT$/../../packages/provider-node/src/zcode-builtin-release.ts",
        "$TURBO_ROOT$/../../packages/model-option-map/src/**",
        "$TURBO_ROOT$/../../packages/shared/src/**",
        "$TURBO_ROOT$/../../.env",
        "$TURBO_ROOT$/../../.env.production",
        "$TURBO_ROOT$/../../.env.development",
        "$TURBO_ROOT$/../../.env.development.local",
        "$TURBO_ROOT$/../../package.json",
        "$TURBO_ROOT$/../../pnpm-lock.yaml"
      ],
      "outputs": ["dist/**"],
      "cache": true,
      "env": ["ZCODE_ENV", "ZCODE_BUILTIN_PROVIDER_CONFIG_FILE", "NODE_ENV"]
    },
    "@zcode/office-runtime#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@zcode/documents-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@zcode/spreadsheets-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@zcode/presentations-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@zcode/pdf-plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "@zcode/node-repl-host#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    }
  }
}
