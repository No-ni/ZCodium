{
  "name": "@zcode/dynamic-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./projections": {
      "types": "./dist/projections.d.ts",
      "import": "./dist/projections.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-libs.mjs && tsc",
    "charts": "node scripts/generate-libs.mjs && tsc && node scripts/generate-mermaid.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test:source": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "test:upstream": "node scripts/generate-libs.mjs && vitest run tests --reporter=verbose",
    "test": "corepack pnpm test:source && corepack pnpm test:upstream",
    "typecheck": "node scripts/generate-libs.mjs && tsc --noEmit",
    "coverage": "node scripts/generate-libs.mjs && vitest run tests --coverage",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --write src tests"
  },
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.5"
  }
}
