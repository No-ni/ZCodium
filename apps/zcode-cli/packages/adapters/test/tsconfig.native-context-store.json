{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@zcode/shared/node": ["../../../../../packages/shared/src/node.ts"],
      "@zcode/shared": ["../../../../../packages/shared/src/index.ts"],
      "@zcode/shared/native-context-compression": [
        "../../../../../packages/shared/src/native-context-compression/index.ts"
      ],
      "@zcode/shared/sqlite-migrations": [
        "../../../../../packages/shared/src/sqlite-migrations/index.ts"
      ],
      "@zcode/adapters/storage": ["../src/storage/index.ts"],
      "@zcode/contracts": ["../../contracts/src/index.ts"]
    }
  },
  "include": ["native-context-*.test.ts", "fixtures/native-context-store.ts"]
}
