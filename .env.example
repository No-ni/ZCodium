# 用户自有 ZCode endpoint（部署覆盖也可放在未跟踪的 .env.local 中）。
# 本仓不内置官方地址：留空时不启用依赖远端控制面的功能，也不会回退到任何官方域名。
ZCODE_BASE_URL=
ZCODE_ENDPOINT_ORIGIN=
# 用户自带 API Key 的 BigModel Provider API；属于用户选择的 Provider。
BIGMODEL_API_BASE_URL=https://bigmodel.cn

# 可选本地 Provider 配置文件路径；留空使用随包内置的本地配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 本地资源/网络采样默认关闭；只有显式设为 1 才启用，结果仅写入本地诊断日志。
ZCODE_LOCAL_RESOURCE_MONITORING=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# 官方 MCP 鉴权额外信任的 http loopback origin，逗号分隔。
# image-search 插件默认指向本地后端（见该插件 .zcode-plugin/plugin.json 的
# userConfig.imageSearchBaseUrl，默认 http://127.0.0.1:8787），必须在这里登记
# 该 origin，否则请求会在客户端被 isOfficialMcpOriginTrusted 直接拒绝。
# 注意：插件 userConfig 只能通过插件设置或改 manifest 默认值覆盖，不读环境变量。
# 安全权衡：最坏情况只是把用户自己的 JWT 发给本机进程，而本机任意程序本就能读到
# 同一份凭证，因此不扩大信任面。不设置时行为与未实现该开关时一致。
ZCODE_OFFICIAL_MCP_DEV_TRUSTED_ORIGINS=
